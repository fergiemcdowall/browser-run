{
  "name": "browser-run",
  "description": "Transform stream that executes JavaScript it receives in a real browser and outputs console output",
  "version": "12.0.1",
  "repository": {
    "type": "git",
    "url": "git://github.com/juliangruber/browser-run.git"
  },
  "homepage": "https://github.com/juliangruber/browser-run",
  "main": "index.js",
  "bin": {
    "browser-run": "./bin/bin.js"
  },
  "scripts": {
    "build": "browserify browser/reporter.js -o static/reporter.js",
    "prepublish": "npm run build",
    "release": "np",
    "pretest": "npm run build"
  },
  "dependencies": {
    "browser-launcher": "^4.0.0",
    "duplexer": "^0.1.2",
    "ecstatic": "^4.1.4",
    "electron-stream": "^12.0.0",
    "enstore": "^1.0.1",
    "html-inject-script": "^2.0.0",
    "server-destroy": "^1.0.1",
    "source-map-support": "^0.5.21",
    "through": "^2.3.8",
    "xhr-write-stream": "^0.1.2",
    "xtend": "^4.0.2",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "concat-stream": "^2.0.0",
    "np": "^12.0.1",
    "tree-kill": "^1.2.2",
    "utf8-stream": "^0.0.0"
  },
  "keywords": [
    "browser",
    "stream",
    "test",
    "headless",
    "duplex"
  ],
  "author": {
